# Template — multi-stage Python service (uv, current official pattern)
# Requires BuildKit (default with `docker build` / `docker compose build`).
# Verify the uv guide: https://docs.astral.sh/uv/guides/integration/docker/
FROM python:3.14-slim AS builder

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Compile .pyc on install (faster cold start); copy instead of hardlink across the cache mount.
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

# Copy the uv binary from the official image (pin the tag/digest in your org).
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /bin/

# Install dependencies first (no project code yet) so the layer caches across source edits.
# The cache mount persists uv's download/build cache between builds; the bind mounts expose
# the lockfiles without copying them into the layer.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-dev

# Now copy the project and install it (this layer rebuilds when source changes).
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

# Runtime image (non-root) — copy only the resolved virtualenv, not the whole /app or uv itself.
FROM python:3.14-slim AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Put the venv on PATH so `python`/entrypoints resolve without `uv run`.
ENV PATH="/app/.venv/bin:$PATH"

RUN useradd -m -u 10001 appuser
USER appuser

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv
COPY --chown=appuser:appuser . .

EXPOSE 8080
CMD ["python", "-m", "your_service"]
